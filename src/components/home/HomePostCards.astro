---
import PostCard from '@/components/shared/PostCard.astro'
import type { Post } from '@/types/content.types'
import type { Language } from '@/types/language.types'

type Props = {
  posts: Post[]
  language: Language
}

const { posts, language } = Astro.props
---

<ul class="cards">
  {posts.map((post) => (
    <li>
      <PostCard post={post} language={language} />
    </li>
  ))}
</ul>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;

    @media (width < 720px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
