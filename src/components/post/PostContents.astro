---
import type { MarkdownHeading } from 'astro'
import type { Strings } from '@/types/i18n.types'

type Props = {
  sections: MarkdownHeading[]
  strings: Strings['post']
}

const { sections, strings } = Astro.props
---

{sections.length > 0 && (
  <details class="contents">
    <summary>{strings.contents}</summary>
    <ol>
      {sections.map(({ depth, slug, text }) => (
        <li data-depth={depth}>
          <a href={`#${slug}`}>{text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

<style>
  .contents {
    margin-top: 1.5rem;
    border: var(--line-guide);
    background: var(--color-raised);

    @media (width >= 1360px) {
      display: none;
    }
  }

  summary {
    padding: 0.5rem 0.9rem;
    color: var(--color-blue);
    font-family: var(--font-hand);
    font-size: 1.05rem;
    cursor: pointer;
  }

  ol {
    margin: 0;
    padding: 0 0.9rem 0.7rem;
    list-style: none;
  }

  li[data-depth='3'] {
    padding-left: 1rem;
    font-size: 0.88rem;
  }

  a {
    display: block;
    color: var(--color-body);
    font-family: var(--font-hand);
    font-size: 0.95rem;
    line-height: 1.9;
    text-decoration: none;

    &:hover {
      color: var(--color-crimson);
    }
  }
</style>
