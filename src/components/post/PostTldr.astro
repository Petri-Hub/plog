---
import type { Strings } from '@/types/i18n.types'

type Props = {
  url: string
  strings: Strings['post']
}

const { url, strings } = Astro.props
---

<a class="tldr" href={url} target="_blank" rel="noopener">
  {strings.tldrTitle} · {strings.tldrText} <span aria-hidden="true">↗</span>
  <span class="sr-only">{strings.newTab}</span>
</a>

<style>
  .tldr {
    display: inline-block;
    margin-top: 1.75rem;
    padding: 0.35rem 0.75rem;
    background: var(--color-sticky-yellow);
    box-shadow: 0 1px 1px var(--color-shadow-paper);
    color: var(--color-sticky-ink);
    font-family: var(--font-hand);
    text-decoration: none;
    rotate: -1deg;

    @media (width >= 1360px) {
      display: none;
    }

    &:hover {
      color: var(--color-sticky-red);
    }
  }
</style>
