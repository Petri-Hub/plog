---
import Column from './Column.astro'
import ThemeToggle from './ThemeToggle.astro'
import Wordmark from './Wordmark.astro'
import { SearchMenu } from '@/components/search/SearchMenu'
import type { Post } from '@/types/content.types'
import type { Strings } from '@/types/i18n.types'
import type { AlternateLanguageLinks, Language } from '@/types/language.types'
import { getLanguageDetails, languages } from '@/utils/locale.utils'
import { toSearchEntries } from '@/utils/search.utils'

type Props = {
  language: Language
  homeUrl: string
  alternates: AlternateLanguageLinks
  strings: Strings['header']
  searchPosts: Post[]
  searchStrings: Strings['search']
}

const { language, homeUrl, alternates, strings, searchPosts, searchStrings } = Astro.props
---

<header class="header">
  <Column>
    <div class="bar">
      <a class="logo" href={homeUrl}>
        <Wordmark />
        <span class="subtitle">{strings.subtitle}</span>
      </a>
      <div class="tools">
        <SearchMenu
          client:idle
          entries={toSearchEntries(searchPosts)}
          language={language}
          strings={searchStrings}
        />
        <nav aria-label={strings.language}>
          <ul class="languages">
            {languages.map((alternate) => {
              const { tag, name, label } = getLanguageDetails(alternate)

              return (
                <li>
                  <a
                    class="language"
                    href={alternates[alternate]}
                    hreflang={tag}
                    lang={tag}
                    title={name}
                    aria-current={alternate === language ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              )
            })}
          </ul>
        </nav>
        <ThemeToggle strings={strings} />
      </div>
    </div>
  </Column>
</header>

<style>
  .header {
    border-bottom: var(--line-guide);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.2rem 1.35rem;
  }

  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    line-height: 1;
    text-decoration: none;
  }

  .subtitle {
    color: var(--color-blue);
    font-family: var(--font-hand);
    font-size: 0.95rem;
    rotate: -2deg;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .languages {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    color: var(--color-muted);
    font-family: var(--font-hand);
    font-size: 1.05rem;
    list-style: none;

    & li + li::before {
      content: '/' / '';
    }
  }

  .language {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    text-decoration: none;

    &:hover,
    &[aria-current='page'] {
      color: var(--color-crimson);
    }

    &[aria-current='page']::after {
      content: '';
      position: absolute;
      inset: 0.25rem 0;
      border: 1.5px solid currentColor;
      border-radius: 50%;
      filter: var(--filter-rough);
    }
  }
</style>
