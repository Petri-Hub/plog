---
import type { Post } from '@/types/content.types'
import type { Language } from '@/types/language.types'
import { toLocalizedDate } from '@/utils/date.utils'
import { createUrlFromPostId, toHashtags } from '@/utils/post.utils'

type Props = {
  post: Post
  language: Language
  label?: string
}

const { post, language, label } = Astro.props

const { title, description, date, tags } = post.data
---

<article class="card">
  <p class="meta">
    {label && <span>{label}</span>}
    <time datetime={date.toISOString()}>{toLocalizedDate(date, language)}</time>
    {tags.length > 0 && <span>{toHashtags(tags)}</span>}
  </p>
  <h3 class="title">
    <a href={createUrlFromPostId(post.id)}>{title}</a>
  </h3>
  <p class="description">{description}</p>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1rem 1.2rem;
    border: var(--line-guide);
    isolation: isolate;
    transition: translate 0.2s;

    &::before,
    &::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    &::before {
      z-index: -1;
      background: var(--color-raised);
    }

    &::after {
      z-index: -2;
      background: var(--texture-hatch);
      translate: 7px 7px;
      transition: translate 0.2s;
    }

    &:hover {
      translate: -3px -3px;

      &::after {
        translate: 10px 10px;
      }
    }
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-hand);
    font-size: 0.92rem;
    line-height: 1.4;

    & > * + *::before {
      content: '·' / '';
      margin-right: 0.5rem;
      color: var(--color-muted);
    }
  }

  .title {
    margin: 0;
    font-size: 1.38rem;
    line-height: 1.12;

    & a {
      color: var(--color-crimson);
      text-decoration: none;

      &::after {
        content: '';
        position: absolute;
        inset: 0;
      }

      &:focus-visible {
        outline: none;

        &::after {
          outline: 2px dashed var(--color-blue);
          outline-offset: 2px;
        }
      }
    }
  }

  .description {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
</style>
