---
import Column from './Column.astro'

type Props = {
  id: string
  title: string
  note: string
  isBoard?: boolean
}

const { id, title, note, isBoard = false } = Astro.props
---

<section class="section" aria-labelledby={id} data-board={isBoard ? '' : undefined}>
  <Column>
    <div class="head">
      <h2 class="title" id={id}>
        {title}
      </h2>
      <p class="note">{note}</p>
    </div>
    <slot />
  </Column>
</section>

<style>
  .section {
    padding-block: 2.75rem 3.25rem;
    border-top: var(--line-guide);

    &[data-board] {
      background: var(--color-band);
    }
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-bottom: 1.75rem;
  }

  .title {
    margin: 0;
    font-size: clamp(1.9rem, 3.4vw, 2.35rem);
  }

  .note {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-hand);
    font-size: 1.02rem;
    rotate: -2deg;
  }
</style>
