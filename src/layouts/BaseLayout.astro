---
import { Font } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { ClientRouter } from 'astro:transitions'
import Desk from '@/components/shared/Desk.astro'
import Footer from '@/components/shared/Footer.astro'
import Header from '@/components/shared/Header.astro'
import RoughFilter from '@/components/shared/RoughFilter.astro'
import Sheet from '@/components/shared/Sheet.astro'
import { getStrings } from '@/i18n/strings'
import '@/styles/tokens.css'
import '@/styles/base.css'
import '@/styles/prose.css'
import type { Post } from '@/types/content.types'
import type { AlternateLanguageLinks } from '@/types/language.types'
import { getLanguageDetails, languages, toLanguage } from '@/utils/locale.utils'

type Props = {
  title: string
  description: string
  alternates: AlternateLanguageLinks
  searchPosts: Post[]
  isDeskCleared?: boolean
}

const { title, description, alternates, searchPosts, isDeskCleared = false } = Astro.props

const language = toLanguage(Astro.currentLocale)
const strings = getStrings(language)

const homeUrl = getRelativeLocaleUrl(language)
---

<!doctype html>
<html lang={getLanguageDetails(language).tag}>
  <head>
    <title>{`PLOG | ${title}`}</title>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    {languages.map((alternate) => (
      <link
        rel="alternate"
        hreflang={getLanguageDetails(alternate).tag}
        href={new URL(alternates[alternate], Astro.site).href}
      />
    ))}

    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates['pt-br'], Astro.site).href}
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={strings.rss.title}
      href={new URL(`${language}/rss.xml`, Astro.site).href}
    />

    <Font cssVariable="--font-title" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-text" preload />
    <Font cssVariable="--font-hand" preload />

    <script is:inline>
      function handleSavedTheme() {
        const theme = localStorage.getItem('theme')

        if (theme) {
          document.documentElement.dataset.theme = theme
        }
      }

      handleSavedTheme()
      document.addEventListener('astro:after-swap', handleSavedTheme)
    </script>

    <ClientRouter />
  </head>
  <body>
    <RoughFilter />
    <Desk language={language} isCleared={isDeskCleared} strings={strings.desk} />
    <slot name="desk" />
    <Sheet>
      <Header
        language={language}
        homeUrl={homeUrl}
        alternates={alternates}
        strings={strings.header}
        searchPosts={searchPosts}
        searchStrings={strings.search}
      />
      <main>
        <slot />
      </main>
      <Footer
        homeUrl={homeUrl}
        rssUrl={getRelativeLocaleUrl(language, 'rss.xml')}
        strings={strings.footer}
      />
    </Sheet>
  </body>
</html>
