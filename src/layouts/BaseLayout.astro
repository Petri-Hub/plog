---
import { ClientRouter } from 'astro:transitions'
import type { AlternateLanguageLinks } from '../types/language.types'

type Props = {
  title: string
  alternates: AlternateLanguageLinks
}

const { title, alternates } = Astro.props
---

<!DOCTYPE html>
<html lang="en">
<head>
  <title>{title}</title>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {
    Object.entries(alternates).map(([language, link]) => (
      <link rel="alternate" hreflang={language} href={`https://blog.petri.zip${link}`} />
    ))
  }

  {
    alternates['pt-br'] && (
      <link rel="alternate" hreflang="x-default" href={`https://blog.petri.zip${alternates['pt-br']}`} />
    )
  }

  <ClientRouter />
</head>
<body>
  <slot />
</body>
</html>