---
import { ClientRouter } from 'astro:transitions'

type Props = {
  title: string
}

const { title } = Astro.props
---

<!DOCTYPE html>
<html lang="en">
<head>
  <title>{title}</title>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <ClientRouter />
</head>
<body>
  <slot />
</body>
</html>