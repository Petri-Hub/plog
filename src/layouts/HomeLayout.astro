---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/shared/Header.astro";
import Main from "../components/shared/Main.astro"
import { SearchMenu } from "../components/search/SearchMenu";
import type { AlternateLanguageLinks } from "../types/language.types";

const alternates: AlternateLanguageLinks = {
    'pt-br': '/pt-br/',
    'en-us': '/en-us/'
  }

---

<BaseLayout alternates={alternates} title="Plog | Início">
  <Header alternates={alternates}/>
  <Main>
    <SearchMenu />
    <slot />
  </Main>
</BaseLayout>