---
import { getRelativeLocaleUrl } from 'astro:i18n'
import BaseLayout from './BaseLayout.astro'
import { HomePostList } from '../components/home/HomePostList'
import { SearchMenu } from '../components/search/SearchMenu'
import { getStrings } from '../i18n/strings'
import type { Post } from '../types/content.types'
import type { AlternateLanguageLinks } from '../types/language.types'
import { toLanguage } from '../utils/locale.utils'

type Props = {
  highlights: Post[]
  recents: Post[]
  posts: Post[]
}

const { highlights, recents, posts } = Astro.props

const language = toLanguage(Astro.currentLocale)
const strings = getStrings(language)

const alternates: AlternateLanguageLinks = {
  'pt-br': getRelativeLocaleUrl('pt-br'),
  'en-us': getRelativeLocaleUrl('en-us'),
}
---

<BaseLayout title={strings.home.title} alternates={alternates}>
  <SearchMenu
    client:only="react"
    posts={posts}
    enabled={false}
    language={language}
    strings={strings.search}
  />
  <section>
    <h1>{strings.home.heading}</h1>
    <p>{strings.home.subheading}</p>
  </section>
  <section>
    <h2>{strings.home.highlights}</h2>
    <HomePostList posts={highlights} language={language} />
  </section>
  <section>
    <h2>{strings.home.recents}</h2>
    <HomePostList posts={recents} language={language} />
  </section>
</BaseLayout>
