---
import { getRelativeLocaleUrl } from 'astro:i18n'
import BaseLayout from './BaseLayout.astro'
import HomeHero from '@/components/home/HomeHero.astro'
import HomePostCards from '@/components/home/HomePostCards.astro'
import HomePostList from '@/components/home/HomePostList.astro'
import HomeUpcoming from '@/components/home/HomeUpcoming.astro'
import Section from '@/components/shared/Section.astro'
import { getStrings } from '@/i18n/strings'
import type { Post } from '@/types/content.types'
import type { AlternateLanguageLinks } from '@/types/language.types'
import { toLanguage } from '@/utils/locale.utils'

type Props = {
  highlights: Post[]
  recents: Post[]
}

const { highlights, recents } = Astro.props

const language = toLanguage(Astro.currentLocale)
const strings = getStrings(language)

const alternates: AlternateLanguageLinks = {
  'pt-br': getRelativeLocaleUrl('pt-br'),
  'en-us': getRelativeLocaleUrl('en-us'),
}
---

<BaseLayout
  title={strings.home.title}
  description={strings.home.description}
  alternates={alternates}
>
  <HomeHero strings={strings.home} />
  <Section id="highlights" title={strings.home.highlights} note={strings.home.highlightsNote}>
    <HomePostCards posts={highlights} language={language} />
  </Section>
  <Section id="posts" title={strings.home.recents} note={strings.home.recentsNote}>
    <HomePostList posts={recents} language={language} />
  </Section>
  <Section id="upcoming" title={strings.home.upcoming} note={strings.home.upcomingNote} isBoard>
    <HomeUpcoming strings={strings.upcoming} />
  </Section>
</BaseLayout>
