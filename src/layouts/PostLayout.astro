---
import type { MarkdownHeading } from 'astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import BaseLayout from './BaseLayout.astro'
import PostCodeCopy from '@/components/post/PostCodeCopy.astro'
import PostContents from '@/components/post/PostContents.astro'
import PostHeader from '@/components/post/PostHeader.astro'
import PostNeighbors from '@/components/post/PostNeighbors.astro'
import PostTldr from '@/components/post/PostTldr.astro'
import Column from '@/components/shared/Column.astro'
import Section from '@/components/shared/Section.astro'
import { getStrings } from '@/i18n/strings'
import type { AdjacentPosts, Post } from '@/types/content.types'
import { toLanguage } from '@/utils/locale.utils'
import { createMarkdownUrlFromPostId, toAlternateMap } from '@/utils/post.utils'

type Props = {
  post: Post
  headings: MarkdownHeading[]
  adjacent: AdjacentPosts
}

const { post, headings, adjacent } = Astro.props

const language = toLanguage(Astro.currentLocale)
const strings = getStrings(language)

const markdownUrl = new URL(createMarkdownUrlFromPostId(post.id), Astro.site).href
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  alternates={toAlternateMap(post)}
>
  <article>
    <PostHeader
      post={post}
      language={language}
      homeUrl={getRelativeLocaleUrl(language)}
      strings={strings.post}
    />
    <Column>
      <PostTldr markdownUrl={markdownUrl} strings={strings.post} />
      <PostContents headings={headings} strings={strings.post} />
      <div class="prose">
        <slot />
      </div>
      <PostCodeCopy />
    </Column>
  </article>
  {(adjacent.newer || adjacent.older) && (
    <Section id="keep-reading" title={strings.post.keepReading} note={strings.post.keepReadingNote}>
      <PostNeighbors adjacent={adjacent} language={language} strings={strings.post} />
    </Section>
  )}
</BaseLayout>
