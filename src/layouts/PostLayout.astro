---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/shared/Header.astro";
import Main from "../components/shared/Main.astro";

type Props = {
  name: string
  alternates: {
    'pt-br': string,
    'en-us': string
  }
}

const { name, alternates } = Astro.props
---

<BaseLayout alternates={alternates} title={`Plog | ${name}`}>
  <Header alternates={alternates}/>
  <Main>
    <slot />
  </Main>
</BaseLayout>
