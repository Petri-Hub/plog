---
import HomeLayout from '../../layouts/HomeLayout.astro'
import {
  getAllPosts,
  getHighlightedPosts,
  getRecentPosts,
} from '../../contents/services/post.service'

const highlights = await getHighlightedPosts('en-us')
const recents = await getRecentPosts('en-us')
const posts = await getAllPosts()
---

<HomeLayout highlights={highlights} recents={recents} posts={posts} />
