---
import PostLayout from '@/layouts/PostLayout.astro'
import { getPostContent, getPosts } from '@/contents/services/post.service'
import type { Post } from '@/types/content.types'
import { toAlternateMap, toPostSlug } from '@/utils/post.utils'

export async function getStaticPaths() {
  const posts = await getPosts('en-us')

  return posts.map((post) => ({
    params: { slug: toPostSlug(post.id) },
    props: { post },
  }))
}

type Props = {
  post: Post
}

const { post } = Astro.props

const { Content } = await getPostContent(post)
const alternates = toAlternateMap(post)
---

<PostLayout title={post.data.title} description={post.data.description} alternates={alternates}>
  <Content />
</PostLayout>
