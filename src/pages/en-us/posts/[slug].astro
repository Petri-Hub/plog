---
import PostLayout from '@/layouts/PostLayout.astro'
import {
  getAdjacentPosts,
  getPostContent,
  getPosts,
  getRecentPosts,
} from '@/contents/services/post.service'
import type { Post } from '@/types/content.types'
import { toPostSlug } from '@/utils/post.utils'

export async function getStaticPaths() {
  const posts = await getPosts('en-us')

  return posts.map((post) => ({
    params: { slug: toPostSlug(post.id) },
    props: { post },
  }))
}

type Props = {
  post: Post
}

const { post } = Astro.props

const { Content, headings } = await getPostContent(post)
const adjacent = await getAdjacentPosts(post)
const searchPosts = await getRecentPosts('en-us')
---

<PostLayout post={post} headings={headings} adjacent={adjacent} searchPosts={searchPosts}>
  <Content />
</PostLayout>
