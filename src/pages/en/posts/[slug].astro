---
import PostLayout from '../../../layouts/PostLayout.astro'
import { getPostById, getPosts } from '../../../contents/services/PostService'
import { toIdWithoutLanguage } from '../../../utils/id.utils'
import { render } from 'astro:content'

export async function getStaticPaths() {
  return await getPosts('en').then((posts) =>
    posts.map((post) => ({
      params: {
        slug: toIdWithoutLanguage(post.id),
      },
    })),
  )
}

const { slug } = Astro.params
const post = await getPostById('en', slug)

if(!post){
  throw new Error("teste")
}

const { Content } = await render(post)
---

<PostLayout name="teste"> <Content /></PostLayout>
