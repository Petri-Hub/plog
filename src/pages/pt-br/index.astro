---
import { getHighlightedPosts, getPostsOrderedByDate } from "../../contents/services/PostService";
import { toIdWithoutLanguage } from '../../utils/id.utils'
import HomeLayout from "../../layouts/HomeLayout.astro";

const highlights = await getHighlightedPosts('pt-br')
const recents = await getPostsOrderedByDate('pt-br')

console.log(toIdWithoutLanguage("en/teste123"))

---

<HomeLayout title="PLOG | Início">
  <section>
    <h2>
      Bem vindo ao meu blog
    </h2>
    <p>
      Assuntos de tecnologia e coisas por aí
    </p>
  </section>
  <section>
    <h3>Destaques</h3>
    <ul>
      {
        highlights.filter(post => post.data.highlighted).map(({id, data: { title, description, tags, date} }) => (
          <li>
            <a href={`./posts/${toIdWithoutLanguage(id)}`}>
            <article>
              <p>{date} - {tags}</p>
              <h4>{title}</h4>
              <p>{description}</p>
            </article>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
   <section>
    <h3>Recentes</h3>
    <ul>
      {
        recents.map(({id, data: { title, description, tags, date} }) => (
          <li>
            <a href={`./posts/${toIdWithoutLanguage(id)}`}>
            <article>
              <p>{date} - {tags}</p>
              <h4>{title}</h4>
              <p>{description}</p>
            </article>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</HomeLayout>
