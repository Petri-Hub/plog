---
import PostLayout from '../../../layouts/PostLayout.astro'
import { getPostById, getPosts } from '../../../contents/services/post.service'
import { toIdWithoutLanguage } from '../../../utils/id.utils'
import { render } from 'astro:content'
import { toAlternateMap } from '../../../utils/alternates.utils'

export async function getStaticPaths() {
  return await getPosts('pt-br').then((posts) =>
    posts.map((post) => ({
      params: {
        slug: toIdWithoutLanguage(post.id),
      },
    })),
  )
}

const { slug } = Astro.params
const post = await getPostById('pt-br', slug)

if(!post){
  throw new Error("teste")
}

const alternates = toAlternateMap(post.data.alternates)

const { Content } = await render(post)
---

<PostLayout name="teste", alternates={alternates}> <Content /></PostLayout>
